{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.d.ts",
    ".forgeax/generated/**/*.d.ts",
    "vitest.config.ts"
  ]
}
